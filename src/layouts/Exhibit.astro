---
import type { MarkdownLayoutProps } from 'astro';
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';
import Base from './Base.astro';

type Props = MarkdownLayoutProps<{
  title: string;
  description: string;
  question: string;
  guide: string;
}>;

const { title, description, question, guide } = Astro.props.frontmatter;
const slug = Astro.url.pathname.split('/').filter(Boolean).at(-1);
const experiments = import.meta.glob<AstroComponentFactory>('../exhibits/*/Experiment.astro', {
  eager: true,
  import: 'default',
});
const Experiment = experiments[`../exhibits/${slug}/Experiment.astro`];
---

<Base title={title} description={description}>
  <article class="exhibit">
    <header class="exhibit-heading">
      <a class="back" href="/#exhibits">← All exhibits</a>
      <h1>{title}</h1>
      <p class="question">{question}</p>
    </header>
    {Experiment && <Experiment />}
    <details class="guide">
      <summary>How to read this</summary>
      <p>{guide}</p>
    </details>
    <div class="notes">
      <slot />
    </div>
  </article>
</Base>

<style>
  .exhibit {
    padding: clamp(1rem, 2.4vw, 1.85rem) 0 4rem;
  }

  .exhibit-heading {
    margin-bottom: clamp(1.5rem, 3vw, 2rem);
  }

  .back {
    display: inline-flex;
    margin-bottom: 1rem;
    color: var(--muted);
    font-size: 0.9rem;
    text-decoration: none;
  }

  .back:hover {
    color: var(--accent);
  }

  .exhibit h1 {
    font-size: clamp(2.65rem, 6vw, 4.6rem);
    line-height: 1.1;
    letter-spacing: normal;
  }

  .question {
    max-width: 42ch;
    margin: 0.65rem 0 0;
    color: var(--muted);
    font-size: clamp(1rem, 1.85vw, 1.3rem);
  }

  .guide {
    margin-top: 1rem;
    border: 1px solid var(--line);
    border-radius: 0.35rem;
    background: var(--panel);
  }

  .guide summary {
    padding: 0.8rem 1rem;
    color: var(--accent);
    font-weight: 600;
    cursor: pointer;
  }

  .guide p {
    max-width: 72ch;
    margin: 0;
    padding: 0 1rem 1rem;
    color: var(--muted);
  }

  .notes {
    max-width: 62ch;
    margin: 3rem auto 0;
    color: var(--muted);
    font-size: 1.075rem;
    line-height: 1.75;
  }

  .notes :global(h2) {
    margin-top: 2.5rem;
    color: var(--ink);
    font-size: clamp(1.6rem, 4vw, 2.2rem);
    line-height: 1.2;
    letter-spacing: normal;
  }

  .notes :global(p) {
    margin-block: 1rem;
  }

  .notes :global(li + li) {
    margin-top: 0.6rem;
  }

  .notes :global(strong) {
    color: var(--ink);
  }

  .notes :global(math[display="block"]) {
    max-width: 100%;
    margin-block: 1.3rem;
    overflow-x: auto;
    color: var(--ink);
  }
</style>
