---
import { SAMPLE_COUNT } from './model';
import { DEFAULT_CIRCLES } from './outline';
---

<section class="scene-panel" aria-label="Fourier drawing experiment">
  <canvas
    id="fourier-plot"
    class="scene-view"
    role="img"
    aria-label="Rotating circles whose combined motion traces a paper-plane outline"
    aria-describedby="fourier-legend"
  >
    Rotating arrows are joined tip to tail. The end of the last arrow follows the reconstructed outline.
  </canvas>
  <ul id="fourier-legend" class="scene-legend" aria-label="Plot legend">
    <li><span class="reference" aria-hidden="true"></span>Original outline</li>
    <li><span aria-hidden="true"></span>Reconstruction</li>
    <li><span class="circles" aria-hidden="true"></span>Rotating circles</li>
  </ul>
  <div class="scene-toolbar">
    <div class="scene-controls">
      <label for="fourier-count">Rotating circles</label>
      <div class="scene-range">
        <input id="fourier-count" type="range" min="0" max={SAMPLE_COUNT - 1} value={DEFAULT_CIRCLES} />
        <output id="fourier-count-value" for="fourier-count" aria-live="off">{DEFAULT_CIRCLES}</output>
      </div>
      <div class="scene-actions">
        <button id="fourier-play" type="button">Play</button>
        <button id="fourier-restart" type="button">Restart trace</button>
      </div>
    </div>
    <p class="scene-readout">RMS sample error <output id="fourier-error" aria-label="RMS sample error">—</output></p>
  </div>
</section>

<script src="./experiment.ts"></script>

<style>
  .scene-legend .reference {
    border-top: 2px dashed var(--muted);
  }

  .scene-legend .circles {
    border-color: var(--secondary);
  }
</style>
