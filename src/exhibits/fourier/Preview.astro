---
import { decompose, evaluate, type Point, sampleOutline, vectorAt } from './model';
import { DEFAULT_CIRCLES, outline } from './outline';

const harmonics = decompose(sampleOutline(outline)).slice(0, DEFAULT_CIRCLES + 1);
const [stationary, ...rotating] = harmonics;
const phase = 0.17;
const center = { x: 280, y: 133 };
const scale = 120;
const screen = (point: Point) => ({ x: center.x + point.x * scale, y: center.y - point.y * scale });
const reference = outline.map(screen);
const reconstructed = Array.from({ length: 145 }, (_, i) => screen(evaluate(harmonics, i / 144)));
const circles = [screen(vectorAt(stationary, phase))];
for (const harmonic of rotating) {
  const vector = vectorAt(harmonic, phase);
  const prior = circles[circles.length - 1];
  circles.push({ x: prior.x + vector.x * scale, y: prior.y - vector.y * scale });
}
const path = (points: Point[]) => points.map((point, i) => `${i ? 'L' : 'M'}${point.x.toFixed(1)},${point.y.toFixed(1)}`).join(' ');
---

<svg viewBox="0 0 560 320" aria-hidden="true" focusable="false">
  {circles.slice(0, -1).map((point, i) => <circle cx={point.x} cy={point.y} r={Math.hypot(circles[i + 1].x - point.x, circles[i + 1].y - point.y)} fill="none" stroke="#78918a" stroke-opacity="0.5" stroke-width="1" />)}
  {circles.slice(0, -1).map((point, i) => <line x1={point.x} y1={point.y} x2={circles[i + 1].x} y2={circles[i + 1].y} stroke="#8bbab0" stroke-opacity="0.84" stroke-width="1.5" />)}
  <path d={`${path(reference)} Z`} fill="none" stroke="#d3a86e" stroke-width="1.4" stroke-dasharray="3 5" opacity="0.66" />
  <path d={path(reconstructed)} fill="none" stroke="#75c7b8" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
  <circle cx={circles[circles.length - 1].x} cy={circles[circles.length - 1].y} r="3.5" fill="#f0bd74" />
</svg>
