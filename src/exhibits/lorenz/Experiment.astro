<section class="scene-panel" aria-label="Lorenz trajectory comparison">
  <canvas
    id="plot"
    class="scene-view"
    role="img"
    aria-label="Two Lorenz trajectories viewed in the x-z plane. The solid path starts at (1, 1, 1), and the dashed path starts nearby."
  ></canvas>
  <ul class="scene-legend" aria-label="Trajectories">
    <li><span aria-hidden="true"></span>Baseline</li>
    <li><span class="shifted" aria-hidden="true"></span>Shifted start</li>
  </ul>
  <div class="scene-toolbar">
    <div class="scene-controls">
      <label for="separation">Initial separation</label>
      <div class="scene-range">
        <input id="separation" type="range" min="0.01" max="1" step="0.01" value="0.1" />
        <output id="separation-value" for="separation" aria-live="off">0.10</output>
      </div>
      <div class="scene-actions">
        <button id="toggle" type="button">Pause</button>
        <button id="reset" type="button">Reset</button>
      </div>
    </div>
    <p id="readout" class="scene-readout">Time 0.00 · separation 0.10</p>
  </div>
</section>

<script src="./experiment.ts"></script>

<style>
  .scene-legend .shifted {
    border-top: 2px dashed var(--secondary);
  }
</style>
