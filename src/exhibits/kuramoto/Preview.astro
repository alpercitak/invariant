---
import { createState, orderParameter, step } from './model';

let state = createState(19);
for (let i = 0; i < 115; i += 1) state = step(state, 2.15);
const mean = orderParameter(state.phases);
const cx = 280;
const cy = 135;
const radius = 103;
const dots = state.phases.map((phase, i) => ({
  x: cx + radius * Math.cos(phase),
  y: cy + radius * Math.sin(phase),
  color: i % 3 === 0 ? '#e6ae63' : '#72c7bb',
}));
const arrowLength = radius * mean.coherence;
const arrowEnd = { x: cx + arrowLength * Math.cos(mean.meanPhase), y: cy + arrowLength * Math.sin(mean.meanPhase) };
---

<svg viewBox="0 0 560 320" aria-hidden="true" focusable="false">
  <circle cx={cx} cy={cy} r={radius} fill="#172321" stroke="#52605a" stroke-width="1.2" />
  <circle cx={cx} cy={cy} r="72" fill="none" stroke="#394a45" stroke-width="1" stroke-dasharray="2 6" />
  {dots.map((dot) => <circle cx={dot.x} cy={dot.y} r="4.1" fill={dot.color} opacity="0.92" />)}
  <line x1={cx} y1={cy} x2={arrowEnd.x} y2={arrowEnd.y} stroke="#f2bd70" stroke-width="3" stroke-linecap="round" />
  <circle cx={arrowEnd.x} cy={arrowEnd.y} r="4" fill="#f2bd70" />
  <circle cx={cx} cy={cy} r="3" fill="#f2bd70" />
</svg>
