<section class="scene-panel" aria-label="Kuramoto simulation">
  <canvas
    id="oscillators"
    class="scene-view"
    role="img"
    aria-label="Phases of 64 oscillators around a circle. The amber arrow shows the mean phase and how closely the phases align."
  ></canvas>
  <div class="scene-toolbar">
    <div class="scene-controls">
      <label for="coupling">Coupling</label>
      <div class="scene-range">
        <input id="coupling" type="range" min="0" max="5" step="0.1" value="1.2" />
        <output id="coupling-value" for="coupling" aria-live="off">1.2</output>
      </div>
      <div class="scene-actions">
        <button id="play" type="button">Pause</button>
        <button id="reset" type="button">Reset</button>
      </div>
    </div>
    <p class="scene-readout">Synchrony <output id="synchrony" aria-live="off">—</output></p>
  </div>
</section>

<script src="./experiment.ts"></script>
