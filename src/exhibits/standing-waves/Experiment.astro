---
import { DEFAULT_HARMONIC, MAX_HARMONIC, MIN_HARMONIC } from './model';
import { modeReadout } from './plot';
import StringPlot from './StringPlot.astro';
---

<section class="scene-panel" aria-label="Standing wave experiment">
  <div class="wave-view">
    <StringPlot />
  </div>
  <ul class="scene-legend" aria-label="Plot legend">
    <li><span aria-hidden="true"></span>String</li>
    <li><span class="node" aria-hidden="true"></span>Still points (nodes)</li>
    <li><span class="limit" aria-hidden="true"></span>Motion limits</li>
  </ul>
  <div class="scene-toolbar">
    <div class="scene-controls">
      <label for="standing-harmonic">Harmonic</label>
      <div class="scene-range">
        <input id="standing-harmonic" type="range" min={MIN_HARMONIC} max={MAX_HARMONIC} value={DEFAULT_HARMONIC} />
        <output id="standing-value" for="standing-harmonic" aria-live="off">{DEFAULT_HARMONIC}</output>
      </div>
    </div>
    <div class="scene-actions">
      <button id="standing-play" type="button" aria-controls="standing-string">Play</button>
    </div>
    <p class="scene-readout"><output id="standing-result">{modeReadout(DEFAULT_HARMONIC)}</output></p>
  </div>
</section>

<script src="./experiment.ts"></script>

<style>
  .wave-view {
    border-radius: 0.2rem;
    background: var(--paper);
  }

  .wave-view :global(svg) {
    max-width: 58rem;
    margin-inline: auto;
  }

  .scene-legend {
    gap: 0.6rem 1.3rem;
    margin-top: 1rem;
    font-family: inherit;
    font-size: 0.875rem;
  }

  .scene-legend .node {
    width: 0.45rem;
    height: 0.45rem;
    margin-inline: 0.35rem;
    border: 0;
    border-radius: 50%;
    background: var(--secondary);
  }

  .scene-legend .limit {
    border-top: 2px dashed var(--secondary);
  }

  .scene-toolbar {
    row-gap: 0.85rem;
    margin-top: 1.1rem;
  }
</style>
