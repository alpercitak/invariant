---
import Board from './Board.astro';
import { buildDissection, DEFAULT_LEG } from './model';

const { hypotenuse, legs } = buildDissection(DEFAULT_LEG);
---

<svg viewBox="0 0 14 8" aria-hidden="true">
  <g transform="translate(2.65 0.75) scale(0.52)"><Board board={hypotenuse} /></g>
  <text x="7" y="2.57" fill="#8fd3ce" font-size="0.5" text-anchor="middle" dominant-baseline="central">=</text>
  <g transform="translate(7.71 0.75) scale(0.52)"><Board board={legs} /></g>
</svg>
