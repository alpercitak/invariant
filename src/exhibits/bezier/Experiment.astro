---
import CurvePlot from './CurvePlot.astro';
import { deCasteljau } from './model';
import { DEFAULT_T, INITIAL_POINTS, pointReadout } from './plot';
---

<section class="scene-panel" aria-label="Bézier curve experiment">
  <div class="board">
    <CurvePlot />
  </div>
  <ul class="scene-legend" aria-label="Plot legend">
    <li><span aria-hidden="true"></span>Curve</li>
    <li><span class="first" aria-hidden="true"></span>First step</li>
    <li><span class="second" aria-hidden="true"></span>Second step</li>
  </ul>
  <div class="scene-toolbar">
    <div class="scene-controls">
      <label for="bezier-parameter">Parameter t</label>
      <div class="scene-range">
        <input id="bezier-parameter" type="range" min="0" max="1" step="0.01" value={DEFAULT_T} />
        <output id="bezier-value" for="bezier-parameter" aria-live="off">{DEFAULT_T.toFixed(2)}</output>
      </div>
    </div>
    <div class="scene-actions">
      <button id="bezier-reset" type="button">Reset curve</button>
    </div>
    <p class="scene-readout">
      <output id="bezier-reading" aria-label="Point on the curve">{pointReadout(deCasteljau(INITIAL_POINTS, DEFAULT_T).point)}</output>
    </p>
  </div>
</section>

<script src="./experiment.ts"></script>

<style>
  .scene-panel {
    --bezier-second: #c0aaf1;
  }

  .board {
    background: var(--paper);
    border-radius: 0.2rem;
  }

  .board :global(svg) {
    max-width: 49rem;
    margin-inline: auto;
  }

  .scene-legend {
    gap: 0.6rem 1.35rem;
    margin-top: 1rem;
    font-family: inherit;
    font-size: 0.875rem;
  }

  .scene-legend .first {
    border-color: var(--secondary);
  }

  .scene-legend .second {
    border-top: 2px dashed var(--bezier-second);
  }

  .scene-toolbar {
    row-gap: 0.85rem;
    margin-top: 1.1rem;
  }
</style>
