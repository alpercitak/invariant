<section class="experiment" aria-labelledby="voronoi-title">
	<div class="intro">
		<div>
			<p class="eyebrow">A map made from distance</p>
			<h2 id="voronoi-title">Which warehouse is closest?</h2>
			<p>Each colored patch belongs to the warehouse nearest to every point inside it. Drag a site to see the map redraw.</p>
		</div>
		<button class="reset" type="button">Reset sites</button>
	</div>
	<div class="map-wrap">
		<!-- biome-ignore lint/a11y/useSemanticElements: SVG group contains individually keyboard-operable sites. -->
		<svg class="map" viewBox="0 0 1000 620" role="group" aria-label="Bounded map divided into nearest-warehouse regions">
			<g class="cells" aria-hidden="true"></g>
			<g class="sites"></g>
		</svg>
	</div>
	<p class="status" aria-live="polite">Six warehouses serve the map. Move a site to explore its region.</p>
	<p class="hint">To move a warehouse with the keyboard, focus it and use the arrow keys. Hold Shift for larger steps.</p>
</section>

<style>
	.experiment { border: 1px solid var(--line); border-radius: .4rem; background: var(--panel); padding: clamp(1rem, 3vw, 2rem); margin: 2rem 0; }
	.intro { display:flex; justify-content:space-between; align-items:start; gap:1rem; margin-bottom:1.25rem; }
	.intro h2 { margin:.2rem 0 .5rem; font-size:clamp(1.3rem, 3vw, 2rem); }
	.intro p { margin:0; max-width:54ch; color:var(--muted); }
	.eyebrow { color:var(--accent); font: .75rem var(--mono); text-transform:uppercase; letter-spacing:.08em; }
	.reset { background:transparent; border:1px solid var(--line); color:var(--ink); padding:.6rem .8rem; cursor:pointer; white-space:nowrap; }
	.reset:hover { border-color:var(--accent); }
	.reset:focus-visible, .map :global(.site:focus-visible) { outline:3px solid var(--accent); outline-offset:4px; }
	.map-wrap { border:1px solid var(--line); overflow:hidden; background:var(--paper); }
	.map { display:block; width:100%; height:auto; touch-action:none; }
	.map :global(.cell) { stroke:var(--paper); stroke-width:3; vector-effect:non-scaling-stroke; opacity:.82; }
	.map :global(.site) { cursor:grab; }
	.map :global(.site:active) { cursor:grabbing; }
	.map :global(.site .marker) { fill:var(--paper); stroke:var(--ink); stroke-width:3; vector-effect:non-scaling-stroke; }
	.map :global(.site .hit-area) { fill:transparent; }
	.map :global(.site text) { fill:var(--ink); font:700 20px var(--mono); text-anchor:middle; dominant-baseline:central; pointer-events:none; }
	.status { margin:.85rem 0 .25rem; color:var(--ink); }
	.hint { color:var(--muted); font-size:.9rem; margin:0; }
	@media (max-width:600px) { .intro { display:block; } .reset { margin-top:1rem; } }
</style>

<script src="./experiment.ts"></script>
