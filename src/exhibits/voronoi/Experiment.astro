<section class="experiment" aria-labelledby="voronoi-title">
	<div class="intro">
		<div>
			<p class="eyebrow">A map made from distance</p>
			<h2 id="voronoi-title">Which warehouse is closest?</h2>
			<p>Each colored patch belongs to the warehouse nearest to every point inside it. Drag a site to see the map redraw.</p>
		</div>
		<button class="reset" type="button">Reset sites</button>
	</div>
	<div class="map-wrap">
		<!-- biome-ignore lint/a11y/useSemanticElements: SVG group contains individually keyboard-operable sites. -->
		<svg class="map" viewBox="0 0 1000 620" role="group" aria-label="Bounded map divided into nearest-warehouse regions">
			<g class="cells" aria-hidden="true"></g>
			<g class="sites"></g>
		</svg>
	</div>
	<p class="status" aria-live="polite">Six warehouses serve the map. Move a site to explore its region.</p>
	<p class="hint">To move a warehouse with the keyboard, focus it and use the arrow keys. Hold Shift for larger steps.</p>
</section>

<style>
	.experiment { border: 1px solid var(--line); border-radius: .4rem; background: var(--panel); padding: clamp(1rem, 3vw, 2rem); margin: 2rem 0; }
	.intro { display:flex; justify-content:space-between; align-items:start; gap:1rem; margin-bottom:1.25rem; }
	.intro h2 { margin:.2rem 0 .5rem; font-size:clamp(1.3rem, 3vw, 2rem); }
	.intro p { margin:0; max-width:54ch; color:var(--muted); }
	.eyebrow { color:var(--accent); font: .75rem var(--mono); text-transform:uppercase; letter-spacing:.08em; }
	.reset { background:transparent; border:1px solid var(--line); color:var(--ink); padding:.6rem .8rem; cursor:pointer; white-space:nowrap; }
	.reset:hover { border-color:var(--accent); }
	.reset:focus-visible, .map :global(.site:focus-visible) { outline:3px solid var(--accent); outline-offset:4px; }
	.map-wrap { border:1px solid var(--line); overflow:hidden; background:var(--paper); }
	.map { display:block; width:100%; height:auto; touch-action:none; }
	.map :global(.cell) { stroke:var(--paper); stroke-width:3; vector-effect:non-scaling-stroke; opacity:.82; }
	.map :global(.site) { cursor:grab; }
	.map :global(.site:active) { cursor:grabbing; }
	.map :global(.site .marker) { fill:var(--paper); stroke:var(--ink); stroke-width:3; vector-effect:non-scaling-stroke; }
	.map :global(.site .hit-area) { fill:transparent; }
	.map :global(.site text) { fill:var(--ink); font:700 20px var(--mono); text-anchor:middle; dominant-baseline:central; pointer-events:none; }
	.status { margin:.85rem 0 .25rem; color:var(--ink); }
	.hint { color:var(--muted); font-size:.9rem; margin:0; }
	@media (max-width:600px) { .intro { display:block; } .reset { margin-top:1rem; } }
</style>

<script>
	import { type Point, voronoiCells } from "./model";

	const svg = document.querySelector<SVGSVGElement>(".map");
	const cellLayer = document.querySelector<SVGGElement>(".cells");
	const siteLayer = document.querySelector<SVGGElement>(".sites");
	const status = document.querySelector<HTMLParagraphElement>(".status");
	const reset = document.querySelector<HTMLButtonElement>(".reset");
	if (svg && cellLayer && siteLayer && status && reset) {
		const initial: Point[] = [
			{ x: 170, y: 130 }, { x: 470, y: 105 }, { x: 820, y: 170 },
			{ x: 250, y: 440 }, { x: 570, y: 350 }, { x: 830, y: 490 },
		];
		let sites = initial.map((point) => ({ ...point }));
		const colors = ["#dfa74b", "#73b9aa", "#d58354", "#7da6c1", "#be8baf", "#9ba96a"];
		let dragging: { index: number; pointerId: number } | undefined;
		const namespace = 'http://www.w3.org/2000/svg';
		const siteGroups = initial.map((_, index) => {
			const group = document.createElementNS(namespace, 'g');
			group.setAttribute('class', 'site');
			group.setAttribute('tabindex', '0');
			group.setAttribute('role', 'group');
			group.dataset.index = String(index);
			const hitArea = document.createElementNS(namespace, 'circle');
			hitArea.setAttribute('class', 'hit-area');
			hitArea.setAttribute('r', '64');
			const dot = document.createElementNS(namespace, 'circle');
			dot.setAttribute('class', 'marker');
			dot.setAttribute('r', '24');
			const label = document.createElementNS(namespace, 'text');
			label.textContent = String(index + 1);
			group.append(hitArea, dot, label);
			return group;
		});
		siteLayer.append(...siteGroups);

		const draw = () => {
			cellLayer.replaceChildren();
			const cells = voronoiCells(sites, { width: 1000, height: 620 });
			cells.forEach((polygon, index) => {
				if (!polygon.length) return;
				const shape = document.createElementNS(namespace, 'polygon');
				shape.setAttribute("points", polygon.map(({ x, y }) => `${x},${y}`).join(" "));
				shape.setAttribute("fill", colors[index % colors.length]);
				shape.setAttribute("class", "cell");
				cellLayer.append(shape);
			});
			sites.forEach((point, index) => {
				const group = siteGroups[index];
				group.setAttribute("transform", `translate(${point.x} ${point.y})`);
				group.setAttribute(
					"aria-label",
					`Warehouse ${index + 1} at x ${Math.round(point.x)}, y ${Math.round(point.y)}. Use arrow keys to move.`,
				);
			});
		};
		function move(index: number, x: number, y: number) {
			sites[index] = { x: Math.max(20, Math.min(980, x)), y: Math.max(20, Math.min(600, y)) };
			draw();
		}
		const announce = (index: number) => {
			const { x, y } = sites[index];
			status.textContent = `Warehouse ${index + 1} is at x ${Math.round(x)}, y ${Math.round(y)}.`;
		};
		svg.addEventListener("pointerdown", (event) => {
			const target = event.target instanceof Element && event.target.closest<SVGGElement>('.site');
			if (!target || dragging || event.button !== 0) return;
			dragging = { index: Number(target.dataset.index), pointerId: event.pointerId };
			svg.setPointerCapture(event.pointerId);
		});
		svg.addEventListener('pointermove', (event) => {
			if (dragging?.pointerId !== event.pointerId) return;
			const bounds = svg.getBoundingClientRect();
			move(dragging.index, (event.clientX - bounds.left) * 1000 / bounds.width, (event.clientY - bounds.top) * 620 / bounds.height);
		});
		svg.addEventListener('lostpointercapture', (event) => {
			if (dragging?.pointerId !== event.pointerId) return;
			announce(dragging.index);
			dragging = undefined;
		});
		svg.addEventListener("keydown", (event) => {
			const target = event.target instanceof Element && event.target.closest<SVGGElement>('.site');
			if (!target) return;
			const delta = event.shiftKey ? 25 : 8;
			const change: Record<string, Point> = {
				ArrowLeft: { x: -delta, y: 0 }, ArrowRight: { x: delta, y: 0 },
				ArrowUp: { x: 0, y: -delta }, ArrowDown: { x: 0, y: delta },
			};
			const step = change[event.key]; if (!step) return;
			event.preventDefault(); const index = Number(target.dataset.index);
			move(index, sites[index].x + step.x, sites[index].y + step.y);
			announce(index);
		});
		reset.addEventListener('click', () => {
			sites = initial.map((point) => ({ ...point }));
			draw();
			status.textContent = 'All six warehouses are back at their starting positions.';
		});
		draw();
	}
</script>
