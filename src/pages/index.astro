---
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';
import Base from '@/layouts/Base.astro';

interface Entry {
  url: string;
  frontmatter: { title: string };
}

const previews = import.meta.glob<AstroComponentFactory>('../exhibits/*/Preview.astro', {
  eager: true,
  import: 'default',
});
const entries = Object.entries(import.meta.glob<Entry>('./exhibits/*.md', { eager: true })).map(([path, page]) => ({
  ...page,
  slug: path.split('/').at(-1)?.replace(/\.md$/, '') ?? '',
}));
const order = new Map(
  ['kuramoto', 'lorenz', 'voronoi', 'fourier', 'logistic', 'galton', 'mandelbrot', 'standing-waves', 'bezier'].map((slug, index) => [
    slug,
    index,
  ]),
);
const exhibits = entries.sort((a, b) => (order.get(a.slug) ?? order.size) - (order.get(b.slug) ?? order.size));
---

<Base description="An interactive archive of mathematical patterns. Explore synchrony, chaos, geometry, waves, probability, and fractals one scene at a time.">
  <section id="exhibits" class="archive" aria-labelledby="archive-title">
    <h1 id="archive-title">The Pattern Archive</h1>
    <ul class="gallery">
      {exhibits.map(({ url, frontmatter, slug }) => {
        const Preview = previews[`../exhibits/${slug}/Preview.astro`];
        return (
          <li>
            <a class="card" href={url} data-exhibit={slug}>
              {Preview && <Preview />}
              <div class="card-label">
                <h2>{frontmatter.title}</h2>
                <span aria-hidden="true">→</span>
              </div>
            </a>
          </li>
        );
      })}
    </ul>
  </section>
</Base>

<style>
  .archive {
    padding: clamp(1.85rem, 4vw, 3.4rem) 0 clamp(2rem, 6vw, 5rem);
    scroll-margin-top: 0.75rem;
  }

  h1 {
    margin-bottom: clamp(1.35rem, 3vw, 2.3rem);
    font-size: clamp(2.75rem, 6vw, 4.5rem);
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(0.8rem, 2vw, 1.25rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .card {
    position: relative;
    isolation: isolate;
    display: grid;
    align-items: end;
    aspect-ratio: 7 / 4;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 0.45rem;
    color: var(--ink);
    background: radial-gradient(ellipse at 50% 36%, var(--scene-glow, var(--panel)), var(--paper) 78%);
    text-decoration: none;
  }

  .card[data-exhibit="kuramoto"] {
    --scene-glow: #20342f;
  }

  .card[data-exhibit="lorenz"] {
    --scene-glow: #293145;
  }

  .card[data-exhibit="voronoi"] {
    --scene-glow: #29352c;
  }

  .card[data-exhibit="fourier"] {
    --scene-glow: #3d3021;
  }

  .card[data-exhibit="logistic"] {
    --scene-glow: #203632;
  }

  .card[data-exhibit="galton"] {
    --scene-glow: #303047;
  }

  .card[data-exhibit="standing-waves"] {
    --scene-glow: #243536;
  }

  .card[data-exhibit="bezier"] {
    --scene-glow: #332d45;
  }

  .card:hover,
  .card:focus-visible {
    border-color: var(--accent);
  }

  .card :global(svg) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .card-label {
    position: relative;
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 1.9rem clamp(0.95rem, 3vw, 1.65rem) clamp(0.75rem, 2vw, 1.2rem);
    background: linear-gradient(transparent, #101315 83%);
  }

  .card-label h2 {
    font-size: clamp(1.85rem, 3.4vw, 2.75rem);
  }

  .card-label span {
    display: grid;
    flex: 0 0 2rem;
    height: 2rem;
    place-items: center;
    border: 1px solid var(--line);
    border-radius: 50%;
    color: var(--accent);
    background: var(--paper);
  }

  .card:hover .card-label span,
  .card:focus-visible .card-label span {
    border-color: var(--accent);
    color: var(--paper);
    background: var(--accent);
  }

  @media (width <= 650px) {
    .gallery {
      grid-template-columns: 1fr;
    }
  }
</style>
