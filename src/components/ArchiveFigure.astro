---
interface Props {
  kind: string;
}

const { kind } = Astro.props;
const angles = [-2.74, -2.32, -1.79, -1.55, -0.99, -0.73, -0.56, -0.47, -0.39, -0.28, -0.16, 0, 0.21, 0.89, 2.1];
const dots = angles.map((angle) => [255 + 117 * Math.cos(angle), 173 + 117 * Math.sin(angle)]);
const meanX = 117 * angles.reduce((sum, angle) => sum + Math.cos(angle), 0) / angles.length;
const meanY = 117 * angles.reduce((sum, angle) => sum + Math.sin(angle), 0) / angles.length;
const meanLength = Math.hypot(meanX, meanY);
const meanAngle = Math.atan2(meanY, meanX) * 180 / Math.PI;
---

<svg viewBox="0 0 510 346" fill="none" aria-hidden="true" focusable="false">
  <path d="M38 38v14m0-14h14m420 0h-14m14 0v14M38 308v-14m0 14h14m420 0h-14m14 0v-14" stroke="var(--line)" />
  <path d="M38 173h434M255 37v272" stroke="var(--line)" stroke-dasharray="2 7" />
  {kind === 'lorenz' ? (
    <g transform="translate(255 172)">
      <path d="M 0 63 C -49 32 -137 7 -157 -42 C -192 -131 -54 -151 -19 -75 C 6 -20 -57 53 -102 17 C -143 -22 -107 -71 -70 -60 C -29 -48 -24 15 0 63 C 60 66 139 3 150 -53 C 169 -148 38 -141 15 -71 C -7 -12 65 39 101 2 C 132 -37 97 -69 69 -51 C 43 -36 49 1 20 35" stroke="var(--secondary)" stroke-width="2" />
      <path d="M -13 55 C -63 43 -150 2 -170 -54 C -200 -143 -40 -149 -15 -63 C 6 0 -66 53 -111 9 C -145 -26 -112 -77 -72 -65 C -37 -49 -31 17 -13 55 C 45 86 131 19 161 -39 C 209 -137 48 -154 18 -83 C -5 -29 44 42 92 15 C 132 -4 115 -71 73 -57 C 35 -41 52 7 10 50" stroke="var(--accent)" stroke-width="1.25" opacity="0.67" />
    </g>
  ) : kind === 'voronoi' ? (
    <g stroke="var(--secondary)" stroke-width="1.5">
      <path d="M100 68H410V278H100Z M205 68 237 151 203 221 214 278 M237 151 321 134 410 192 M321 134 331 68 M203 221 315 278" />
      <g fill="var(--accent)" stroke="none">
        <circle cx="158" cy="163" r="5" /><circle cx="267" cy="107" r="5" /><circle cx="363" cy="105" r="5" />
        <circle cx="324" cy="208" r="5" /><circle cx="241" cy="259" r="5" />
      </g>
    </g>
  ) : (
    <g>
      <circle cx="255" cy="173" r="136" stroke="var(--line)" stroke-dasharray="1 5" />
      <circle cx="255" cy="173" r="117" stroke="var(--accent)" stroke-opacity="0.42" />
      <circle cx="255" cy="173" r="79" stroke="var(--line)" />
      <circle cx="255" cy="173" r="40" stroke="var(--line)" />
      {dots.map(([x, y], index) => (
        <g>
          <path d={`M255 173L${x} ${y}`} stroke="var(--accent)" stroke-opacity={index > 3 && index < 13 ? 0.14 : 0.06} />
          <circle cx={x} cy={y} r={index > 3 && index < 13 ? 3.7 : 2.6} fill="var(--accent)" opacity={index > 3 && index < 13 ? 1 : 0.51} />
        </g>
      ))}
      <path d={`M0 0H${meanLength}m-7-4 7 4-7 4`} transform={`translate(255 173) rotate(${meanAngle})`} stroke="var(--secondary)" stroke-width="1.7" />
      <circle cx="255" cy="173" r="3" fill="var(--secondary)" />
      <path d="M354 102h66m-4-4 4 4-4 4M155 243h-62" stroke="var(--line)" />
    </g>
  )}
</svg>

<style>
  svg {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
